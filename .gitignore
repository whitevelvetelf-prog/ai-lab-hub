.env
/vendor
/node_modules
/config/database.php
/config/translation.php
/config/ai-assistant.php

# Завантажені через CRM логотипи продуктів — користувацький контент,
# змінюється незалежно від коду.
/public/assets/images/logos/

# Зображення оголошень, завантажені через CRM реклами (crm-edit-campaign.php) —
# так само користувацький контент.
/public/assets/images/ads/uploads/

# Обкладинки пропозицій Marketplace, завантажені через CRM (mp-add-offer.php) — користувацький контент.
/public/assets/images/marketplace/covers/

# Тимчасові архіви для заливання (deploy.zip, deploy2.zip, …) — не код проєкту.
/deploy*.zip

# Локальний дебаг-лог листів (app/mailer.php) — може містити токени входу,
# ніколи не комітити. Створюється лише коли mail() недоступний (dev-оточення).
/storage/

# tools/autofill: локальний інструмент автонаповнення. Ключ API в config.php,
# робочі дані (sqlite), SQL-пакети й вивантаження існуючих продуктів — не в git.
# (Те саме є у tools/autofill/.gitignore; тут — друга лінія захисту.)
/tools/autofill/config.php
/tools/autofill/data/
/tools/autofill/export/
/tools/autofill/existing.csv

# Пакет для заливки на хостинг (генерується; містить zip і логотипи) — не в git.
/hosting-upload/

# Локальне перевизначення налаштувань Marketplace (напр. public_enabled => true для розробки).
/config/marketplace.local.php

# Фото оголошень дошки Marketplace (етап 4) — користувацький контент. У git лише .htaccess
# (забороняє виконання PHP у теці); саму теку створює код, якщо її немає.
/public/uploads/marketplace/*
!/public/uploads/marketplace/.htaccess
